{
	"appId": "com.babis.keymaster",
	"appName": "Babis Hub",
	"webDir": ".output/public",
	"server": {
		"url": "https://babis-keymaster.lovable.app",
		"cleartext": false,
		"androidScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1200,
			"launchAutoHide": true,
			"backgroundColor": "#18201a",
			"showSpinner": false
		}
	},
	"packageClassList": [
		"AppPlugin",
		"SplashScreenPlugin"
	]
}
